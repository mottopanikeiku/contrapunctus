[["thread","Ode to Joy","Beethoven’s tune begins with two repeated notes, climbs by step and comes back down. It carries Schiller’s appeal to human fellowship into the Ninth Symphony’s finale. That plain, singable line has travelled through piano transcriptions and public ceremonies far beyond the concert hall.","influence.html#thread-ode-to-joy"],["thread","Frère Jacques","The familiar round enters Mahler’s First Symphony on a solo double bass, in D minor, over the timpani’s tread. Frère Jacques still repeats its little phrases, but now they belong to a funeral procession. The bassoon and cellos join the round.","influence.html#thread-frere-jacques"],["figure","Barbara Strozzi","composer · 1619–1677","influence.html#node-strozzi"],["figure","Élisabeth Jacquet de La Guerre","composer · 1665–1729","influence.html#node-jacquet-de-la-guerre"],["figure","François Couperin","composer · 1668–1733","influence.html#node-couperin"],["figure","Antonio Vivaldi","composer · 1678–1741","influence.html#node-vivaldi"],["figure","Jean-Philippe Rameau","composer · 1683–1764","influence.html#node-rameau"],["figure","Johann Sebastian Bach","composer · 1685–1750","influence.html#node-bach"],["figure","George Frideric Handel","composer · 1685–1759","influence.html#node-handel"],["figure","Domenico Scarlatti","composer · 1685–1757","influence.html#node-scarlatti"],["figure","Carl Philipp Emanuel Bach","composer · 1714–1788","influence.html#node-cpe-bach"],["figure","Joseph Haydn","composer · 1732–1809","influence.html#node-haydn"],["figure","Wolfgang Amadeus Mozart","composer · 1756–1791","influence.html#node-mozart"],["figure","Ludwig van Beethoven","composer · 1770–1827","influence.html#node-beethoven"],["figure","Gioachino Rossini","composer · 1792–1868","influence.html#node-rossini"],["figure","Franz Schubert","composer · 1797–1828","influence.html#node-schubert"]]