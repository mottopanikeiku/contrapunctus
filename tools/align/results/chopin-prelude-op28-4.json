        "old": "ViertelBalken = { #(override-auto-beam-setting '(end * * * *) 1 4 'Staff)\n  #(override-auto-beam-setting '(end * * * *) 1 2 'Staff)\n  #(override-auto-beam-setting '(end * * * *) 3 4 'Staff) }",
