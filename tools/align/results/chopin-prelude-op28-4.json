        "basis": "Replace the removed quarter-beam Scheme API with the equivalent quarter-unit grouping properties; no pitch or duration changes."
      },
      {
        "file": "chp-28-04-a4.ly",
        "old": "\nrechts = \\context Staff \\relative c'{\n  \\context Voice = \"rechts\"",
        "new": "\nrechts = \\context Voice = \"rechts\" \\relative c'{",
