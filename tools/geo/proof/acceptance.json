    "geographicAudit": "()=>{const data=window.__proofIndex,detail=window.__proofDetails[document.querySelector('[name=\"composer\"]').value];const translation=n=>{const s=n.getAttribute('transform');return s.slice(s.indexOf('(')+1,s.indexOf(')')).trim().split(/[ ,]+/).map(Number);};let maxPoint=0,maxNumber=0,maxCameo=0,markers=0,numbers=0;const sea=[];for(const n of document.querySelectorAll('.am-true-marker')){if(n.closest('.am-hidden,[hidden]'))continue;const kind=n.dataset.geoKind;let expected;if(kind==='person'||kind==='premiere'){const c=data.composers.find(c=>c.id===n.dataset.composer),p=c.places[Number(n.dataset.geoPlace??n.dataset.place)];expected=[p.x,p.z];}else if(kind==='route-stop'){const p=detail.places[Number(n.dataset.routePlace)];expected=[p.x,p.z];}else if(kind==='city-numbers'){const s=detail.map.stops.find(s=>s.places.join(',')===n.dataset.routeIndices);expected=[s.x,s.z];}else{const c=data.cities[Number(n.dataset.city??n.dataset.cluster)];expected=[c.x,c.y];}const actual=translation(n),error=Math.hypot(actual[0]-expected[0],actual[1]-expected[1]);maxPoint=Math.max(maxPoint,error);markers++;if(kind==='city-numbers'){const text=n.querySelector('.am-stop-numbers');maxNumber=Math.max(maxNumber,error,Math.hypot(Number(text.getAttribute('x')),Number(text.getAttribute('y'))));numbers++;}if(kind==='person'&&!n.classList.contains('am-collapsed')&&!n.classList.contains('am-dead')){const [dx,dy]=translation(n.querySelector('.am-person-icon')),scale=document.querySelector('.am-world').transform.baseVal.getItem(1).matrix.a;maxCameo=Math.max(maxCameo,Math.hypot(dx,dy)*scale);if(Math.hypot(dx,dy)>.001&&!document.querySelector('.am-base-world>.am-land').isPointInFill(new DOMPoint(expected[0]+dx,expected[1]+dy)))sea.push(n.dataset.composer);}}return{markers,numbers,maxTruePointDisplacement:maxPoint,maxNumberDisplacement:maxNumber,maxCameoLeaderPx:maxCameo,displacedCameosAtSea:sea};}",
    "frameProbe": "(async()=>{const root=document.querySelector('[data-atlas-map]'),original=Element.prototype.getBoundingClientRect;let layoutReads=0;Element.prototype.getBoundingClientRect=function(...args){if(root.contains(this))layoutReads++;return original.apply(this,args);};const from=Number(document.querySelector('#am-year').value),times=[];document.querySelector('[data-action=\"time-play\"]').click();await new Promise(resolve=>{let previous;function sample(t){if(previous!==undefined)times.push(t-previous);previous=t;if(times.length===180)resolve();else requestAnimationFrame(sample);}requestAnimationFrame(sample);});document.querySelector('[data-action=\"time-play\"]').click();Element.prototype.getBoundingClientRect=original;const sorted=[...times].sort((a,b)=>a-b);return{samples:times.length,meanMs:times.reduce((s,n)=>s+n,0)/times.length,p50Ms:sorted[90],p95Ms:sorted[171],maxMs:sorted.at(-1),intervalsOver25Ms:times.filter(t=>t>25).length,from,to:Number(document.querySelector('#am-year').value),mapLayoutReads:layoutReads};})()"
